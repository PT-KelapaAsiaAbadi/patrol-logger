{
	// TODO Highlight: tags in comments, plus the backend stubs ("not implemented:") as work items.
	// The open list lives in README.md under "TODO"; keep it in step when adding or resolving one.
	"todohighlight.isEnable": true,
	"todohighlight.isCaseSensitive": true,
	"todohighlight.include": ["src/**/*.{ts,tsx,css}", "vite.config.ts"],
	"todohighlight.exclude": ["**/node_modules/**", "**/dist/**", "**/dev-dist/**"],
	"todohighlight.keywords": [
		{ "text": "TODO:", "color": "#1f2a37", "backgroundColor": "#f2c94c", "overviewRulerColor": "#f2c94c" },
		{ "text": "FIXME:", "color": "#ffffff", "backgroundColor": "#d64545", "overviewRulerColor": "#d64545" },
		{ "text": "HACK:", "color": "#ffffff", "backgroundColor": "#8a5cf6", "overviewRulerColor": "#8a5cf6" },
		{ "text": "BUG:", "color": "#ffffff", "backgroundColor": "#d64545", "overviewRulerColor": "#d64545" },
		{ "text": "not implemented:", "color": "#ffffff", "backgroundColor": "#3b82f6", "overviewRulerColor": "#3b82f6" }
	]
}
