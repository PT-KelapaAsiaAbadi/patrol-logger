{
  "name": "patrol-logger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "db:types": "supabase gen types typescript --local > database.types.ts",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"supabase/functions/**/*.ts\" \"tests/**/*.{ts,mjs}\" vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"supabase/functions/**/*.ts\" \"tests/**/*.{ts,mjs}\" vite.config.ts",
    "test": "npm run db:reset && node tests/backend.test.mjs && npm run db:reset && node tests/e2e.test.mjs && node tests/camera.test.mjs && node tests/location.test.mjs",
    "test:backend": "node tests/backend.test.mjs",
    "test:e2e": "node tests/e2e.test.mjs",
    "db:reset": "supabase db reset --local",
    "test:camera": "node tests/camera.test.mjs",
    "test:location": "node tests/location.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "lucide-preact": "^1.48.0",
    "preact": "^10.29.8",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "wouter-preact": "^3.11.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "oxlint": "^1.85.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
