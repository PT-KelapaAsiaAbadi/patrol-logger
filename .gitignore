# Files git never tracks: dependencies, build output, local env files with keys, logs and OS clutter.

# Dependencies
node_modules/

# Build output
dist/
dev-dist/
*.tsbuildinfo

# Environment and local overrides
.env
.env.*
!.env.example
*.local

# Logs
*.log
npm-debug.log*

# Source and prototype bundles
*.zip

# OS and editor files
.DS_Store
Thumbs.db
.idea/

# Browser test failure screenshot
e2e-failure.png

# Netlify CLI link (local only)
.netlify/

# AI coding assistants' local settings (Qwen Code)
.qwen/
